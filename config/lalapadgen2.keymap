#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <11 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q       &kp P         &kp U             &kp Y               &kp COMMA                                    &kp J        &kp D         &kp H             &kp G               &kp W
&kp I       &kp O         &kp E             &kp A               &kp PERIOD                                   &kp K        &kp T         &kp N             &kp S               &kp R
&kp Z       &kp X         &kp V             &kp C               &lt 4 SEMICOLON                              &kp M        &kp L         &kp F             &kp B               &kp SLASH
&kp ESCAPE  &kp LEFT_ALT  &mo 3             &kp LCTRL           &kp LEFT_SHIFT   &kp BACKSPACE  &lt 1 SPACE  &lt 5 ENTER  &kp LEFT_GUI  &kp BACKSLASH     &kp LEFT_BRACKET    &kp RIGHT_BRACKET
            &mkp MB3      &kp RIGHT         &kp DOWN            &kp LEFT         &kp UP         &kp UP       &kp LEFT     &kp DOWN      &kp RIGHT         &none
&mkp LCLK   &mkp RCLK     &mkp MCLK                                                                                                     &mkp LCLK         &mkp RCLK           &mkp MCLK
&mkp MB4    &mkp MB5      &kp LC(UP_ARROW)  &kp LC(DOWN_ARROW)  &kp LCTRL                                    &mkp MB4     &mkp MB5      &kp LC(UP_ARROW)  &kp LC(DOWN_ARROW)  &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp GRAVE         &kp EXCLAMATION    &kp AT_SIGN    &kp HASH      &kp PERCENT                  &trans            &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3       &trans
&kp PERCENT       &kp CARET          &kp AMPERSAND  &kp ASTERISK  &kp SQT                      &trans            &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6       &trans
&trans            &trans             &trans         &kp MINUS     &kp EQUAL                    &trans            &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9       &kp KP_NUMBER_0
&trans            &trans             &trans         &trans        &trans       &trans  &trans  &trans            &trans             &trans           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
                  &trans             &trans         &trans        &trans       &trans  &trans  &trans            &trans             &trans           &trans
&trans            &trans             &trans                                                                                         &trans           &trans                &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans         &trans        &trans                       &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans           &trans                &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3
&trans  &trans  &trans  &trans  &trans                  &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL  &trans
&trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans          &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans
&trans  &trans  &trans                                                              &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans          &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F11                  &trans                         &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&trans  &kp F4  &kp F5  &kp F6  &kp F12                  &trans                         &trans                         &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&trans  &kp F7  &kp F8  &kp F9  &trans                   &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
        &trans  &trans  &trans  &trans   &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans  &trans  &trans                                                                                                 &trans                         &trans                         &trans
&trans  &trans  &trans  &trans  &trans                   &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans                      &kp LC(UP_ARROW)  &trans                 &trans                         &trans            &trans                  &trans                  &trans             &trans
&trans  &kp LG(LC(LA(LEFT_ARROW)))  &kp LC(DOWN)      &kp LG(LC(LA(RIGHT)))  &trans                         &kp LC(LA(LEFT))  &kp LC(LA(DOWN_ARROW))  &kp LC(LA(DOWN_ARROW))  &kp LC(LA(RIGHT))  &trans
&trans  &trans                      &trans            &trans                 &trans                         &trans            &trans                  &trans                  &trans             &trans
&trans  &trans                      &trans            &trans                 &trans  &trans  &kp LC(SPACE)  &trans            &kp LC(LA(ENTER))       &trans                  &trans             &trans
        &trans                      &trans            &trans                 &trans  &trans  &trans         &trans            &trans                  &trans                  &trans
&trans  &trans                      &trans                                                                                                            &trans                  &trans             &trans
&trans  &trans                      &trans            &trans                 &trans                         &trans            &trans                  &trans                  &trans             &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F10                  &trans    &trans          &trans        &trans     &trans
&trans  &kp F4  &kp F5  &kp F6  &kp F11                  &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &kp F7  &kp F8  &kp F9  &kp F12                  &trans    &trans          &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans    &trans          &trans        &trans     &trans
        &trans  &trans  &trans  &trans   &trans  &trans  &trans    &trans          &trans        &trans
&trans  &trans  &trans                                                             &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans                   &trans    &trans          &trans        &trans     &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 3>;
            then-layer = <2>;
        };
    };
};
